# ─────────────────────────────────────────────────────────────
# Supabase configuration — Batch Ledger Inventory (LedgerStock)
# Copy this file to `.env` and fill in your project values.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# Public project URL, e.g. https://abcdefghijklmnopqrst.supabase.co
VITE_SUPABASE_URL=

# Your project's "anon public" key — NOT the service_role key, which must
# never be used in the browser. Find it at:
#   Supabase Dashboard → Project Settings → API → Project API keys
VITE_SUPABASE_ANON_KEY=
